# Copy this file to .env for local development. Render (or wherever this
# is deployed) should have these set as real environment variables instead —
# never commit a real .env file.

# --- Database ---------------------------------------------------------
# Postgres URL in production (Render provides this automatically when you
# create a Postgres instance and link it, e.g.
# postgresql://user:pass@host:5432/dbname). Falls back to a local SQLite
# file if unset — fine for local dev.
DATABASE_URL=sqlite:///./bhoomi.db

# --- Auth secrets -------------------------------------------------------
# Secret used to sign member/staff JWT bearer tokens. Use a long random
# string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# The hidden master-admin key for the /admin panel. Compared with a
# constant-time comparison, never logged, never returned in any API
# response. Use a long random string in production.
MASTER_KEY=change-me-to-a-long-random-master-key

# Optional: separate secret for signing the /admin session cookie. If unset,
# it's derived from JWT_SECRET, but a real deployment should set its own.
# ADMIN_SESSION_SECRET=change-me-too

# --- App mode -------------------------------------------------------------
# "development" | "production"
# In development, /api/auth/request-code includes "dev_code" in the response
# so you can log in without a real email/SMS provider. In production this
# field is never included.
BACKEND_ENV=development

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins. For local dev, both PWA
# dev servers. In production, client-app and master-app are published
# alongside the website on the SAME GitHub Pages origin (different subpaths
# of one site), so you only need to add that one origin, e.g.:
#   CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://<your-github-username>.github.io
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Optional SMTP for real OTP email delivery -----------------------------
# If ALL of these are set, OTP codes are emailed via smtplib instead of only
# being logged to the server console. Phone-identifier logins still rely on
# server logs / staff hand-off until a real SMS provider is wired into
# app/notifications.py (see the TODO there).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@bhoomifitness.in

# --- Render -------------------------------------------------------------
# Render injects PORT automatically; the Procfile/Dockerfile CMD reads it.
# No action needed.
